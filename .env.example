# Copiá este archivo a .env y poné ahí la clave real. .env no se versiona.
# En contenedores (Northflank) también se pueden inyectar como variables de entorno.
HOST=0.0.0.0
PORT=8000
# API compatible con OpenAI: POST {MODEL_BASE_URL}/chat/completions
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
# Clave de Jev (TypeSafe AI). Vacía: el evaluador se simula en local.
JEV_API_KEY=
JEV_CONFIDENCE_THRESHOLD=0.85
